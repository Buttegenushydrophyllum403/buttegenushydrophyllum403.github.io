# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI twin (Google Gemini, free tier) ---
# Free key: https://aistudio.google.com/apikey
# Note: on the free tier Google may use prompts to improve its products. The site tells visitors so.
GEMINI_API_KEY=
# Tried in order; when one model's free quota runs out (or it keeps failing), the next takes over.
# Flash-Lite leads because its free daily quota lasts much longer than 3.8 Flash's.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
# Per-visitor limits on the live site (not applied in npm run dev).
# CHAT_LIMIT_PER_MINUTE=8
# CHAT_LIMIT_PER_DAY=40
# Set to "false" to switch the chat off instantly.
CHAT_ENABLED=true
# Dev/tests only: canned replies, no API calls.
# CHAT_MOCK=1

# --- Per-visitor rate limiting (optional: Upstash Redis via Vercel Marketplace) ---
# Without these, an in-memory fallback is used (fine locally, not shared across serverless instances).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Any long random string; used to hash visitor IPs.
IP_HASH_SALT=

# The contact form needs no configuration: it opens the visitor's own email app.
