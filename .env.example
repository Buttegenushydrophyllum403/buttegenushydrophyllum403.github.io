# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI twin (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Set to "false" to switch the chat off instantly.
CHAT_ENABLED=true
# Hard daily cap on estimated chat spend (USD). Also set a monthly limit in the Anthropic Console.
CHAT_DAILY_BUDGET_USD=2
# Only change these if you change CLAUDE_MODEL (USD per million tokens).
# CHAT_PRICE_INPUT_PER_MTOK=5
# CHAT_PRICE_OUTPUT_PER_MTOK=25
# Dev/tests only: canned replies, no API calls.
# CHAT_MOCK=1

# --- Rate limiting + spend tracking (Upstash Redis via Vercel Marketplace) ---
# Without these, an in-memory fallback is used (fine locally, not shared across serverless instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string; used to hash visitor IPs.
IP_HASH_SALT=

# --- Contact form (Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=rifatsarwar17442@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Dev/tests only: validate but don't send.
# CONTACT_DRY_RUN=1
