# Copy to .env.local for local development (npm run dev). Only NEXT_PUBLIC_* values are used by the site:
# it's a static export, and the AI twin's secrets live in the Cloudflare Worker (see .dev.vars.example).

# Where the chat sends messages. Either the deployed worker, or the local one from `npm run twin:dev`.
NEXT_PUBLIC_CHAT_URL=http://localhost:8787/chat
# Used for link previews, the sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
